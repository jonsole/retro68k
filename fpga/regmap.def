# retro68k register map: the one source for every hardware address.
#
# tools/regmap.py reads this file and generates:
#   firmware/include/hw.inc   68000 assembler (vasm) equates
#   firmware/include/hw.h     C header
#   fpga/rtl/regmap.vh        Verilog defines
# and checks it against docs/spec/registers.md.
#
# Edit this file, then run:  python3 tools/regmap.py
#
# Syntax (one item per line, # starts a comment):
#   block   NAME BASE SIZE "text"            a region of the address space
#   reg     OFFSET NAME ACCESS SPEC [fields]  a 32-bit register in the current block
#   regs    NAME COUNT OFFSET ACCESS SPEC     NAME0..NAME(COUNT-1), 4 bytes apart
#   array   NAME COUNT OFFSET STRIDE SPEC     repeated group of registers ...
#   end                                       ... ends an array or struct
#   struct  NAME SIZE SPEC                    a layout in memory (offsets only) ...
#   area    NAME OFFSET SIZE ACCESS SPEC      a memory area inside the current block
#   const   NAME VALUE ["text"]               a named number
# Fields:  FIELD=BIT  or  FIELD=HIGH:LOW.  "fields=OTHER" copies another register's fields.
# Access:  R, W, RW, W1C (sticky, write 1 to clear), RW1C (mixed), SC (set/clear), Q (queued)
# SPEC is "spec/section", e.g. 4/6.1, matching docs/spec.

# ---------------------------------------------------------------- memory map
block CHIPRAM 0x000000 0x400000 "Chip RAM (SRAM, 4 MB; 2 MB boards use the first half), shared with DMA"
block ROM     0xF80000 0x008000 "Boot ROM"

# ---------------------------------------------------------------- custom block
block CUSTOM 0xE00000 0x10000 "Custom registers: video, DMA engine, audio, copper"

# Video (spec 4)
reg 0x000 VIDCON     RW   4/6.1  EN=0 BLANKALL=2 DIRECT=4
reg 0x004 VIDSTAT    RW1C 4/6.1  VBLANK=0 LINE=1 OVERRUN=6:4 SPRUNDER=7 INVBLANK=8
reg 0x008 VIDINTEN   RW   4/6.1  VBLANK=0 LINE=1 OVERRUN=6:4 SPRUNDER=7
reg 0x00C BEAMPOS    R    4/3.3  VLINE=26:16 HPIXEL=10:0
reg 0x010 FRAMECOUNT R    4/3.3  COUNT=15:0
reg 0x014 LINECMP    RW   4/3.4  VLINE=26:16
reg 0x018 BGCOLOR    RW   4/6.1  RGB=23:0
reg 0x01C PRIO       RW   4/4.8  FRONT=1:0 MIDDLE=3:2 BACK=5:4
reg 0x020 VIDSIZE    R    4/6.1  VVISIBLE=26:16 HVISIBLE=10:0

# DMA control (spec 5); its 16-bit value sits in the low half at 0x096, as on the Amiga
reg 0x094 DMACON     SC   5/8    AUD0EN=0 AUD1EN=1 AUD2EN=2 AUD3EN=3 SPREN=5 BLTEN=6 COPEN=7 BPLEN=8 DMAEN=9 SETCLR=15

# Layers 0-2 (spec 4): bitmaps with Amiga-style plane pointers, modulo and data registers
array L 3 0x100 0x80 4/6.2
  reg 0x00 CTRL    RW 4/6.2  EN=0 PLANAR=1 BPP=3:2 TRANSP=4 HSCALE=7:6 VSCALE=9:8 PALOFS=15:12 PLANES=18:16 WRAP=23:20
  reg 0x04 WINX    RW 4/4.3  XSTART=26:16 XEND=10:0
  reg 0x08 WINY    RW 4/4.3  YSTART=26:16 YEND=10:0
  reg 0x0C SCROLLX RW 4/4.4  FINE=3:0
  reg 0x10 BPLSTRIDE RW 4/4.4 BYTES=15:0
  reg 0x14 BPLDMA  SC 4/5.5  PLANES=7:0 SETCLR=15
  reg 0x20 BPL0PT  RW 4/4.4  ADDR=22:0
  reg 0x24 BPL1PT  RW 4/4.4  ADDR=22:0
  reg 0x28 BPL2PT  RW 4/4.4  ADDR=22:0
  reg 0x2C BPL3PT  RW 4/4.4  ADDR=22:0
  reg 0x30 BPL4PT  RW 4/4.4  ADDR=22:0
  reg 0x34 BPL5PT  RW 4/4.4  ADDR=22:0
  reg 0x38 BPL6PT  RW 4/4.4  ADDR=22:0
  reg 0x3C BPL7PT  RW 4/4.4  ADDR=22:0
  reg 0x40 BPL0DAT RW 4/5.1  DATA=15:0
  reg 0x44 BPL1DAT RW 4/5.1  DATA=15:0
  reg 0x48 BPL2DAT RW 4/5.1  DATA=15:0
  reg 0x4C BPL3DAT RW 4/5.1  DATA=15:0
  reg 0x50 BPL4DAT RW 4/5.1  DATA=15:0
  reg 0x54 BPL5DAT RW 4/5.1  DATA=15:0
  reg 0x58 BPL6DAT RW 4/5.1  DATA=15:0
  reg 0x5C BPL7DAT RW 4/5.1  DATA=15:0
end


# DMA engine channels 0-3 (spec 11)
array DMX 4 0x300 0x10 11/8
  reg 0x0 CHDESC RW   11/8  ADDR=23:0
  reg 0x4 CHCTRL RW   11/8  START=0 STOP=1 PAUSE=2 CPUSHARE=5:4
  reg 0x8 CHSTAT RW1C 11/8  BUSY=0 DONE=1 ERR=2 PAUSED=3
  reg 0xC CHERR  R    11/8  ADDR=23:0
end
reg 0x340 DMXINT   W1C 11/8  CH=3:0
reg 0x344 DMXINTEN RW  11/8  CH=3:0

# Sprites (spec 9)
reg 0x500 SPRDMA     SC  9/6    SPR=7:0 SETCLR=15
reg 0x504 SPRCOLL    W1C 9/6    SPR=7:0 L0=15:8 L1=23:16 L2=31:24
array SPR 8 0x520 0x20 9/6
  reg 0x00 PT        RW 9/6    ADDR=22:1
  reg 0x04 H         RW 9/3    HSTART=11:0 HSTOP=27:16
  reg 0x08 V         RW 9/3    VSTART=10:0 VSTOP=26:16
  reg 0x0C CTL       RW 9/3    BPP=13:12 HMAG=17:16 VMAG=19:18 DEPTH=21:20 PAL=27:24
  reg 0x10 DAT       RW 9/6    DATA=15:0
end

# Audio (spec 6)
reg 0x404 AUDRATE    RW  6/5    D=15:0
reg 0x40C AUDSTAT    RW1C 6/5   CH=3:0 ACTIVE=7:4
reg 0x410 AUDINTEN   RW  6/5    CH=3:0
reg 0x414 AUDSTART   W   6/5    CH=3:0
reg 0x418 AUDSTOP    W   6/5    CH=3:0
array AUD 4 0x440 0x20 6/5
  reg 0x00 CTRL      RW 6/5    BITS16=1 NEAREST=2 ONESHOT=3
  reg 0x04 LC        RW 6/5    ADDR=22:0
  reg 0x08 LEN       RW 6/5    SAMPLES=22:0
  reg 0x0C STEP      RW 6/5    STEP=19:0
  reg 0x10 VOL       RW 6/5    L=22:16 R=6:0
  reg 0x14 POS       R  6/5    SAMPLE=22:0
end

# Copper (spec 10)
reg 0x700 COPCON  RW   10/6  EN=0 IRQEN=1 RESUME=2 STKKEEP=3 PRI=5:4
reg 0x704 COP1LC  RW   10/6  ADDR=22:2
reg 0x708 COP2LC  RW   10/6  ADDR=22:2
reg 0x70C COPJMP1 W    10/6
reg 0x710 COPJMP2 W    10/6
reg 0x714 COPPC   R    10/6  ADDR=22:2
reg 0x718 COPSTAT RW1C 10/6  WAITING=0 STOPPED=1 ERR=2 IRQ=3
reg 0x71C COPINT  W    10/6
reg 0x720 COPX    RW   10/6  VALUE=15:0
reg 0x724 COPY    RW   10/6  VALUE=15:0
reg 0x728 COPFLAGS RW  10/6  Z=0 N=1 C=2
reg 0x72C COPSP   RW   10/6  DEPTH=3:0
regs COPR 8 0x740 RW 10/6

# Memory areas in the custom block
area PALETTE 0x4000 0x0400 RW 4/6.3
area DESCRAM 0x6000 0x0800 RW 11/8

# ---------------------------------------------------------------- system block
block SYSTEM 0xF00000 0x10000 "System registers: interrupts, timers, serial, SD card, keyboard, system control"

# Interrupt controller (spec 13)
reg 0x000 INTCON    RW  13/7  MASTER=0
reg 0x004 INTENA    SC  13/7  SRCL=14:0 SETCLRL=15 SRCH=24:16 SETCLRH=31
reg 0x008 INTPEND   R   13/7  SRCL=14:0 SRCH=24:16
reg 0x00C INTRAW    R   13/7  SRCL=14:0 SRCH=24:16
reg 0x010 INTPRI0   RW  13/7
reg 0x014 INTPRI1   RW  13/7
reg 0x018 INTPRI2   RW  13/7
reg 0x01C VECBASE   RW  13/7  VEC=7:0
reg 0x020 SOFTINT   W   13/6  SET=0 CLR=1
reg 0x024 INTID   R   13/7  SRC=4:0
reg 0x028 NMICON    RW  13/5  BUTTONEN=0 USBEN=1
reg 0x02C NMISTAT   W1C 13/5  BUTTON=0 USB=1

# Timers and watchdog (spec 12)
reg 0x100 TIMEHI R 12/3
reg 0x104 TIMELO R 12/3
array TMR 4 0x140 0x20 12/6
  reg 0x00 CTRL     RW  12/6    EN=0 REPEAT=1 SRC=3:2 IRQ=4 DMA=5 DMACH=7:6
  reg 0x04 PRESCALE RW  12/4.2  DIV=15:0
  reg 0x08 RELOAD   RW  12/4.1
  reg 0x0C COUNT    RW  12/4.1
  reg 0x10 STAT     W1C 12/6    UNDER=0
end
reg 0x1C0 WDCTRL RW 12/5  EN=0 LOCK=1
reg 0x1C4 WDTIME RW 12/5  MS=15:0
reg 0x1C8 WDKICK W  12/5  KEY=15:0

# USB serial (spec 14)
reg 0x200 SERCON   RW   14/5    EN=0 CTLEN=1 CTLLOCK=2 TXDROP=3
reg 0x204 SERSTAT  R    14/5    RXCOUNT=27:16 TXSPACE=11:0
reg 0x208 SERDATA  RW   14/4.1  EMPTY=8 BYTE=7:0
reg 0x20C SERLEVEL RW   14/4.2  RXLEVEL=27:16 TXLEVEL=11:0
reg 0x210 SERTIME  RW   14/4.2  US=15:0
reg 0x214 SERIRQ   RW1C 14/4.2  RXREADY=0 RXTIMEOUT=1 TXREADY=2 TXOVF=3
reg 0x218 SERIRQEN RW   14/4.2  fields=SERIRQ
reg 0x21C SERDROP  R    14/4.3  COUNT=15:0

# SD card (spec 15)
reg 0x300 SDCON     RW  15/6    EN=0 CS=1 INITCLK=2 CRCCHK=3 AUTOSTOP=4 CLKDIV=15:8
reg 0x304 SDARG     RW  15/3.2
reg 0x308 SDCMD     W   15/3.2  INDEX=5:0 RESP=9:8 DATA=10 WRITE=11 MULTI=12 APP=13 BLK16=14
regs SDRESP 4 0x30C R 15/3.2
reg 0x31C SDBLKCNT  RW  15/3.3  COUNT=15:0
reg 0x320 SDSTAT    R   15/6    CMDBUSY=0 DATABUSY=1 CARDBUSY=2 INITBUSY=3 FIFOCOUNT=15:4
reg 0x324 SDIRQ     W1C 15/6    CMDDONE=0 DATADONE=1 CMDTIMEOUT=2 CMDERR=3 DATATIMEOUT=4 DATACRC=5 WRITEERR=6 TOKENERR=7
reg 0x328 SDIRQEN   RW  15/6    fields=SDIRQ
reg 0x32C SDTIMEOUT RW  15/6    MS=15:0
reg 0x330 SDDATA    RW  15/3.4

# Keyboard (spec 16)
reg 0x400 KBCON   RW   16/4    EN=0 RAW=1 RESETKEYS=2 MATRIX=3
reg 0x404 KBSTAT  R    16/4    COUNT=4:0 TXBUSY=8
reg 0x408 KBDATA  R    16/3.2  EMPTY=16 RELEASED=15 KEY=8:0
reg 0x40C KBSEND  W    16/3.5  BYTE=7:0
reg 0x410 KBREPLY R    16/3.2  BYTE=7:0
reg 0x414 KBIRQ   RW1C 16/4    EVENT=0 REPLY=1 PARITY=2 FRAME=3 TIMEOUT=4 OVERFLOW=5
reg 0x418 KBIRQEN RW   16/4    fields=KBIRQ
regs KBMAP 16 0x440 R 16/3.4

# System control (specs 7 and 1)
reg 0x800 SYSID      R  7/5    VALUE=31:0
reg 0x804 SYSVER     R  7/5    VALUE=31:0
reg 0x808 SYSCFG     R  7/5    CPU=1:0 CPUMHZ=9:2 CHIPMB=15:10 FASTMB=21:16
reg 0x80C RESETWHY   R  7/2.1  POWER=0 WATCHDOG=1 BUTTON=2 SOFTWARE=3 USB=4 UPLOAD=5 KEYBOARD=6 HALTED=7
reg 0x810 SYSCON     RW 7/9    OVERLAY=0 ROMWE=1 ROMLOCK=2 PROTECT=3 HALTRESET=4
reg 0x814 SYSRESET   W  7/2.1  KEY=15:0
reg 0x818 SYSBTN     R  7/5    MULTIFACE=0 DIVMMC=1
reg 0x820 SYSSTAT    R  1/8    HALTED=0
reg 0x824 BUSERRADDR R  1/6    ADDR=23:0
reg 0x828 BUSERRWHY  R  1/6    UNMAPPED=0 ROMWRITE=1 PROTECT=2 CPUSPACE=3
reg 0x840 I2CCON     RW 7/6    EN=0 CLKDIV=15:8
reg 0x844 I2CDATA    RW 7/6    BYTE=7:0
reg 0x848 I2CCMD     W  7/6    START=0 STOP=1 WRITE=2 READ=3 ACK=4
reg 0x84C I2CSTAT    R  7/6    BUSY=0 NACK=1 ARBLOST=2

# ---------------------------------------------------------------- layouts in memory

# DMA engine descriptor (spec 11, section 3)
struct DMXDESC 32 11/3
  reg 0x00 CTRL   RW 11/3  OP=2:0 FN=7:4 BPP=9:8 DESC=10 HIGH=11 IRQ=12 SRCKIND=14:13 DSTKIND=16:15
  reg 0x04 SRC    RW 11/3  ADDR=23:0
  reg 0x08 DST    RW 11/3  ADDR=23:0
  reg 0x0C WIDTH  RW 11/3  COUNT=23:0
  reg 0x10 HEIGHT RW 11/3  ROWS=15:0 SRCBIT=18:16 DSTBIT=22:20
  reg 0x14 STRIDE RW 11/3  SRCSTRIDE=31:16 DSTSTRIDE=15:0
  reg 0x18 VALUE  RW 11/3
  reg 0x1C NEXT   RW 11/3  ADDR=23:0
end

# Text screen cell (spec 4, section 4.7): 16 bits: character 7-0, foreground 11-8, background 15-12
const TEXTCELL_CHAR_SHIFT 0
const TEXTCELL_FG_SHIFT   8
const TEXTCELL_BG_SHIFT   12

# ---------------------------------------------------------------- named numbers
const SYSID_MAGIC      0x5236384B "R68K"
const WDKICK_MAGIC     0x5A5A
const SYSRESET_MAGIC   0xA55A
const VECBASE_DEFAULT  64

# Interrupt sources (spec 13, section 4); vector = VECBASE + source
const INT_VBLANK 0
const INT_LINE   1
const INT_COPPER 2
const INT_VIDERR 3
const INT_DMA0   4
const INT_DMA1   5
const INT_DMA2   6
const INT_DMA3   7
const INT_AUDIO  9
const INT_TIMER0 11
const INT_TIMER1 12
const INT_TIMER2 13
const INT_TIMER3 14
const INT_SERIAL 15
const INT_SD     16
const INT_KEYB   17
const INT_SOFT   18
const INTB_VBLANK 0   "bit of source 0 in INTENA, INTPEND and INTRAW"
const INTB_LINE   1   "bit of source 1 in INTENA, INTPEND and INTRAW"
const INTB_COPPER 2   "bit of source 2 in INTENA, INTPEND and INTRAW"
const INTB_VIDERR 3   "bit of source 3 in INTENA, INTPEND and INTRAW"
const INTB_DMA0   4   "bit of source 4 in INTENA, INTPEND and INTRAW"
const INTB_DMA1   5   "bit of source 5 in INTENA, INTPEND and INTRAW"
const INTB_DMA2   6   "bit of source 6 in INTENA, INTPEND and INTRAW"
const INTB_DMA3   7   "bit of source 7 in INTENA, INTPEND and INTRAW"
const INTB_AUDIO  9   "bit of source 9 in INTENA, INTPEND and INTRAW"
const INTB_TIMER0 11  "bit of source 11 in INTENA, INTPEND and INTRAW"
const INTB_TIMER1 12  "bit of source 12 in INTENA, INTPEND and INTRAW"
const INTB_TIMER2 13  "bit of source 13 in INTENA, INTPEND and INTRAW"
const INTB_TIMER3 14  "bit of source 14 in INTENA, INTPEND and INTRAW"
const INTB_SERIAL 16  "bit of source 15 in INTENA, INTPEND and INTRAW"
const INTB_SD     17  "bit of source 16 in INTENA, INTPEND and INTRAW"
const INTB_KEYB   18  "bit of source 17 in INTENA, INTPEND and INTRAW"
const INTB_SOFT   19  "bit of source 18 in INTENA, INTPEND and INTRAW"
const VEC_NMI      31
const VEC_SPURIOUS 24

# DMA engine operations, kinds and ports (spec 11)
const DMX_OP_COPY    0
const DMX_OP_FILL    1
const DMX_OP_KEYCOPY 2
const DMX_OP_LOGIC   3
const DMX_OP_ADD     4
const DMX_OP_MIX     5
const DMX_OP_REGLIST 6
const DMX_KIND_MEM   0
const DMX_KIND_PORT  1
const DMX_KIND_NONE  2
const DMX_KIND_VALUE 3
const DMX_PORT_SD     0
const DMX_PORT_SERIAL 1

# Copper instructions (spec 10, section 4)
const COP_EXT       0x80000000 "bit 31: 0 = MOVE, 1 = WAIT, SKIP, JUMP or STOP"
const COP_OP_SHIFT  28         "bits 30-28: the instruction"
const COP_OP_WAIT   0
const COP_OP_SKIP   1
const COP_OP_JUMP   2
const COP_OP_STOP   3
const COP_PIXONLY   0x08000000 "bit 27: WAIT/SKIP compare the pixel position only"
const COP_BLT       0x00008000 "bit 15: WAIT also waits for the DMA engine to be idle"
const COP_V_SHIFT   16
const COP_H_SHIFT   0
const COP_OP_MOVR   4          "MOVE through X and Y"
const COP_OP_ALU    5
const COP_OP_SKIPC  6          "SKIP on a condition"
const COP_OP_CALL   7          "CALL and RET"
const COP_MR_A      0x08000000 "MOVR bit 27: the register offset is X"
const COP_MR_S      0x04000000 "MOVR bit 26: the data is a copper register (bit 24)"
const COP_MR_I      0x02000000 "MOVR bit 25: X goes up by 2 afterwards"
const COP_MR_X      0x01000000 "MOVR bit 24: the data register is X (else Y)"
const COP_FN_SHIFT  25         "ALU bits 27-25: the function"
const COP_FN_LD     0
const COP_FN_ST     1
const COP_FN_ADD    2
const COP_FN_SUB    3
const COP_FN_AND    4
const COP_FN_OR     5
const COP_FN_CMP    6
const COP_D_SHIFT   23         "ALU bits 24-23: the register: 0 X, 1 Y, 3 flags"
const COP_S_SHIFT   21         "ALU bits 22-21: the source: 0 immediate, 1 X, 2 Y, 3 Rn (n in bits 2-0)"
const COP_CC_SHIFT  24         "SKIPC bits 27-24: the condition"
const COP_CC_EQ     0
const COP_CC_NE     1
const COP_CC_LO     2
const COP_CC_HS     3
const COP_CC_MI     4
const COP_CC_PL     5
const COP_CC_HI     6
const COP_CC_LS     7
const COP_RET       0x08000000 "CALL bit 27: RET"
const COP_STACK     8          "stack depth"
